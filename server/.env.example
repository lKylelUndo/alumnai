# Servers
APP_NAME="MyAppName"
PORT=8000
NODE_ENV=development
DATABASE_URL="postgresql://alumnai:your_password@localhost:5432/alumnai"
REDIS_URL="redis://:your_password@localhost:6379"
BACKEND_URL="http://localhost:8000"

# GEMINI API KEY
GEMINI_KEY=

# Github Personal Access Tokens for 5000 request GITHUB REST API per hour
GITHUB_PAT=

# JWT: Generate yours at https://jwtsecrets.com/
JWT_SECRET=

# Cloudinary API KEY & SECRET
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# FRONTEND
FRONTEND_URL="http://localhost:3000"

# Email Credentials (Use GMAIL for Testing Only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="GMAIL Email Address - Replace it here"
SMTP_PASSWORD="Generate GMAIL APP Password - Replace it here" #Tutorial: https://www.youtube.com/watch?v=74QQfPrk4vE
SMTP_FROM="GMAIL Email Address - Replace it here"

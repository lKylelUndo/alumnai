# Servers
APP_NAME="MyAppName"
PORT=8000
NODE_ENV=development
DATABASE_URL="POSTGRESQL CONNECTION STRING - Replace it here (Neon.com)"
REDIS_URL="upstash.com"
BACKEND_URL="http://localhost:8000"

# GEMINI API KEY
GEMINI_KEY=

# Github Personal Access Tokens for 5000 request GITHUB REST API per hour
GITHUB_PAT=

# JWT: Generate yours at https://jwtsecrets.com/
# Both are REQUIRED in production — the server refuses to boot without them.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary API KEY & SECRET
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# FRONTEND
FRONTEND_URL="http://localhost:3000"

# Email Credentials (Use GMAIL for Testing Only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="GMAIL Email Address - Replace it here"
SMTP_PASSWORD="Generate GMAIL APP Password - Replace it here" #Tutorial: https://www.youtube.com/watch?v=74QQfPrk4vE
SMTP_FROM="GMAIL Email Address - Replace it here"
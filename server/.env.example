# Servers
APP_NAME="MyAppName"
PORT=8000
NODE_ENV=development
DATABASE_URL="POSTGRESQL CONNECTION STRING - Replace it here (Neon.com)"
REDIS_URL="upstash.com"
BACKEND_URL="http://localhost:8000"

# GEMINI API KEY
GEMINI_KEY=

# Github Personal Access Tokens for 5000 request GITHUB REST API per hour
GITHUB_PAT=

# JWT: Generate yours at https://jwtsecrets.com/
# Both are REQUIRED in production — the server refuses to boot without them.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Resend (email provider)
RESEND_API_KEY=
# Must be an address on your verified Resend domain, e.g. noreply@yourdomain.com
EMAIL_FROM=

# Cloudinary API KEY & SECRET
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# FRONTEND
FRONTEND_URL="http://localhost:3000"